              <tr>
                {% if requires_shipping and shipping_address %}
                  {% if shipping_methods.size > 0 %}
                    <td class="customer-info__item">
                      <h4>Shipping method</h4>
                      {%- assign unique_shipping_titles = shipping_methods | map: 'title' | uniq -%}
                      <p>
                        {%- if unique_shipping_titles.size == 1 and delivery_promise_branded_shipping_line -%}
                          {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ delivery_promise_branded_shipping_line }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}
                        {%- else -%}
                          {%- for shipping_title in unique_shipping_titles -%}
                            {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ shipping_title }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}{% unless forloop.last %}<br>{% endunless %}
                          {%- endfor -%}
                        {%- endif -%}
                      </p>
                    </td>
                  {% elsif shipping_method %}
                    <td class="customer-info__item">
                      <h4>Shipping method</h4>
                      <p>
                        {% if delivery_promise_branded_shipping_line %}
                          {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ delivery_promise_branded_shipping_line }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}
                        {% else %}
                          {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ shipping_method.title }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}
                        {% endif %}
                      </p>
                    </td>
                  {% endif %}
                {% endif %}
              </tr>
            </table>

            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

