{% assign buyer_email_rtl = false %}{% if locale_direction == 'rtl' %}{% assign buyer_email_rtl = true %}{% endif %}{% assign delivery_method_types = delivery_agreements | map: 'delivery_method_type' | uniq %}
{%- comment -%}
  GT Street order confirmation. Version 1.0, 23/11/2026.
  Based on Shopify's default template: all order, payment and delivery logic is unchanged.
  Edit only the settings below. Logo and accent colour: Settings > Notifications > Customise email templates.
{%- endcomment -%}
{%- assign gt_phone = '0414 854 221' -%}
{%- assign gt_hours = '8am to 6pm' -%}
{%- assign gt_email = 'sales@gtstreet.au' -%}
{%- assign gt_logo = 'https://cdn.shopify.com/s/files/1/0787/6739/0946/files/gt-street-logo.png?v=1792649268&width=540' -%}
{%- assign gt_logo_width = 180 -%}
{%- assign gt_site = 'https://gtstreet.au' -%}
{%- assign gt_instagram = 'https://instagram.com/gtstreet.au' -%}
{%- comment -%} GT Street Rewards. Set gt_rewards_on to false to remove the block from every email. {%- endcomment -%}
{%- assign gt_rewards_on = true -%}
{%- assign gt_rewards_teaser = true -%}
{%- assign gt_rewards_start = 20270101 -%}
{%- assign gt_rewards_start_text = '01/01/2027' -%}
{%- assign gt_rewards_end = 20270630 -%}
{%- assign gt_rewards_end_text = '30/06/2027' -%}
{%- assign gt_rewards_url = 'https://gtstreet.au/apps/rewards' -%}
{%- assign gt_rewards_info = 'https://gtstreet.au/pages/rewards' -%}
{%- assign gt_rewards_terms = 'https://gtstreet.au/apps/rewards/terms' -%}
{% assign has_split_cart = false %}
{% assign non_none_count = 0 %}
{% for type in delivery_method_types %}
  {% unless type == 'none' %}
    {% assign non_none_count = non_none_count | plus: 1 %}
  {% endunless %}
{% endfor %}
{% if non_none_count > 1 %}
  {% assign has_split_cart = true %}
{% endif %}

{% assign non_none_agreements_count = 0 %}
{% for agreement in delivery_agreements %}
  {% unless agreement.delivery_method_type == 'none' %}
    {% assign non_none_agreements_count = non_none_agreements_count | plus: 1 %}
  {% endunless %}
{% endfor %}

{% capture email_title %}
  {% if customer.first_name != blank %}Thanks {{ customer.first_name }}, your order is in{% else %}Thanks, your order is in{% endif %}
{% endcapture %}
{% capture email_body %}
  {% if has_pending_payment %}
    {% if buyer_action_required %}
      You will get a confirmation email once your payment is complete.
    {% else %}
      Your payment is being processed. We will email you as soon as your order is confirmed.
    {% endif %}
  {% elsif payment_charged_on_fulfillment %}
    Hi {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ customer.first_name }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}, we have received your order. Your payment method is charged when your order is ready to dispatch, and we will email you when it is on its way.
  {% else %}
    {% if requires_shipping %}
      {% if has_split_cart %}
        {% case split_cart_delivery_method %}
          {% when 'pick-up' %}
            We will email you as soon as your order is ready to collect.
          {% when 'local' %}
            Hi {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ customer.first_name }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}, we are preparing your order for delivery.
          {% when 'shipping' %}
            We are preparing your order now and will email your tracking details as soon as it is dispatched.
          {% else %}
            We are preparing your order now and will email your tracking details as soon as it is dispatched.
        {% endcase %}
      {% else %}
        {% case delivery_method %}
          {% when 'pick-up' %}
            We will email you as soon as your order is ready to collect.
          {% when 'local' %}
            Hi {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ customer.first_name }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}, we are preparing your order for delivery.
          {% else %}
            We are preparing your order now and will email your tracking details as soon as it is dispatched.
        {% endcase %}
      {% endif %}
        {% if delivery_instructions != blank  %}
          <p><b>Delivery information:</b> {% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ delivery_instructions }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}</p>
        {% endif %}
      {% unless delivery_method_types.size > 1 %}
        {% if consolidated_estimated_delivery_time %}
          {% if non_none_agreements_count > 1 %}
            <h3 class="estimated_delivery__title">Estimated delivery</h3>
            <p>{% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ consolidated_estimated_delivery_time }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}</p>
          {% else %}
            <p>
              Estimated delivery <b>{% if buyer_email_rtl == true %}&rlm;&lrm;<span dir="auto" style="display: inline-block; unicode-bidi: isolate; font-size: inherit;">{% endif %}{{ consolidated_estimated_delivery_time }}{% if buyer_email_rtl == true %}</span>&lrm;&rlm;{% endif %}</b>
            </p>
          {% endif %}
        {% endif %}
      {% endunless %}
    {% endif %}
  {% endif %}
  {% assign gift_card_line_items = line_items | where: "gift_card" %}
  {% assign found_gift_card_with_recipient_email = false %}
  {% for line_item in gift_card_line_items %}
    {% if line_item.properties["__shopify_send_gift_card_to_recipient"] and line_item.properties["Recipient email"] %}
      {% assign found_gift_card_with_recipient_email = true %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if found_gift_card_with_recipient_email %}
    <p>Your gift card recipient will receive an email with their gift card code.</p>
  {% elsif gift_card_line_items.first %}
    <p>Gift cards arrive in a separate email.</p>
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="en"{% if buyer_email_rtl %} dir="rtl"{% endif %}>
